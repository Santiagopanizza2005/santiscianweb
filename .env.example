# Supabase Dashboard > Connect > API Keys
# Nunca publiques la clave secreta ni la subas a Git.
SUPABASE_URL=https://tu-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_reemplaza_esto
SUPABASE_SECRET_KEY=sb_secret_reemplaza_esto
# Token único para crear la primera cuenta administradora. Guardalo de forma segura.
BOOTSTRAP_ACCESS_TOKEN=reemplaza_esto_por_un_token_largo_y_unico

# Suscripciones: credenciales privadas del servidor, iguales al admin
MERCADOPAGO_ACCESS_TOKEN=
# Reserva privada para producción; no se usa automáticamente en el entorno de pruebas.
MERCADOPAGO_PRODUCTION_ACCESS_TOKEN=
MERCADOPAGO_COLLECTOR_ID=
MERCADOPAGO_ENVIRONMENT=test
MERCADOPAGO_WEBHOOK_SECRET=
